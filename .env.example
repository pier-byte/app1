# ── Convex DB (realtime) ──
# Crea il progetto con `npx convex dev` e incolla qui l'URL del deployment
VITE_CONVEX_URL=

# ── Gemini AI ──
# Chiave gratuita: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ── PIN di sicurezza (6 cifre) ──
# Fallback locale. Con Convex attivo il PIN viene validato server-side:
#   npx convex env set APP_PIN 123456
VITE_APP_PIN=123456
